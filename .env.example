# ---------------------------------------------------------------------------
# Contoh environment variable — file ini AMAN di-commit ke GitHub.
# Salin menjadi `.env` (atau `.env.local`) di komputer lokal, lalu isi nilainya.
#
# ATURAN KERAS:
# 1. Hanya variabel berawalan `VITE_` yang diekspos Vite ke bundle browser.
#    Variabel tanpa awalan `VITE_` tidak akan terbaca di frontend.
# 2. DILARANG menaruh dalam `VITE_*`:
#      - SUPABASE_SERVICE_ROLE_KEY  (bypass RLS, hak akses penuh database)
#      - password / connection string database
#      - JWT secret, private key, API secret backend
#    Semua secret itu hanya boleh dipakai di environment server (Vercel) atau
#    Supabase Edge Function — bukan di React.
# 3. `VITE_SUPABASE_ANON_KEY` aman dipublikasikan selama RLS (Row Level
#    Security) pada tabel di Supabase sudah aktif.
# ---------------------------------------------------------------------------

# URL project Supabase, contoh: https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# Kunci publik (anon) Supabase. Aman untuk frontend selama RLS aktif.
VITE_SUPABASE_ANON_KEY=